{
  "name": "@wjunhere/session-synapse",
  "version": "0.2.0",
  "description": "A visual, non-linear conversation workspace for the pi coding agent — session map, branches, and canvas organization.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/host/dsh/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "bin": {
    "synapse": "bin/synapse.js"
  },
  "files": [
    "src",
    "bin",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "npm run check",
    "check": "tsc -p jsconfig.json",
    "prepare": "npm run build",
    "test": "node --test test/*.test.js",
    "verify": "node scripts/verify-all.mjs",
    "verify:dsh": "node scripts/verify-dsh.mjs",
    "start": "node bin/synapse.js start"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "keywords": [
    "pi",
    "pi-web",
    "pi-coding-agent",
    "session",
    "canvas",
    "synapse",
    "visualization"
  ],
  "license": "MIT",
  "author": "wjun (wjunhere)",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjunhere/session-synapse.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.2"
  }
}
